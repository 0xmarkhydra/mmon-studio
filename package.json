{
  "name": "mmon-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Compliance-first desktop replay studio for RTMP broadcasting",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && vite build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "vite": "latest",
    "wait-on": "latest"
  }
}
